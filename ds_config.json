{
    "train_batch_size": 8,
    "train_micro_batch_size_per_gpu": 2,
    "optimizer": {
      "type": "AdamW",
      "params": {
        "lr": 1e-5,
        "betas": [0.9, 0.95],
        "eps": 1e-8,
        "weight_decay": 0.01
      }
    },
    "training_params": {
      "num_epochs": 3
    },
    "fp16": {
      "enabled": true,
      "loss_scale": 0,
      "initial_scale_power": 16,
      "loss_scale_window": 1000,
      "hysteresis": 2,
      "min_loss_scale": 1
    },
    "zero_optimization": {
      "stage": 3,
      "offload_optimizer": {
        "device": "cpu",
        "pin_memory": true
      },
      "offload_param": {
        "device": "cpu",
        "pin_memory": true
      },
      "overlap_comm": true,
      "contiguous_gradients": true,
      "sub_group_size": 1e9,
      "reduce_bucket_size": "auto",
      "stage3_prefetch_bucket_size": "auto",
      "stage3_param_persistence_threshold": "auto"
    },
    "gradient_clipping": 0.1,
    "steps_per_print": 100
  }
  