{
    "train_batch_size": 8,
    "train_micro_batch_size_per_gpu": 2,
    "optimizer": {
      "type": "AdamW",
      "params": {
        "lr": 1e-5,
        "betas": [0.9, 0.95],
        "eps": 1e-8,
        "weight_decay": 0.01
      }
    },
    "training_params": {
      "num_epochs": 3
    },
    "fp16": {
      "enabled": true
    },
    "zero_optimization": {
      "stage": 2,
      "offload_optimizer": {
          "device": "cpu",
          "pin_memory": true
      },
      "allgather_partitions": true,
      "allgather_bucket_size": 5e8,
      "overlap_comm": true,
      "reduce_scatter": true,
      "reduce_bucket_size": 5e8,
      "contiguous_gradients": true,
      "round_robin_gradients": true
    },
    "gradient_clipping": 0.1,
    "steps_per_print": 100
  }
  